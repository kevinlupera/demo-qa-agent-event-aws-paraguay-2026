# The model behind all five scenarios (and the LLM judges). No scenario imports a model, so
# changing it is this one variable — nothing else moves.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_ID=gpt-4o-mini

# Demo 04 · puerta de embarque: the Bedrock Guardrail applied to every answer at runtime.
# Create it once with `python create_guardrail.py` (contextual grounding 0.85 / relevance 0.6)
# and paste the id/version it prints. Without them demo 04 explains what is missing.
GUARDRAIL_ID=
GUARDRAIL_VERSION=1
AWS_REGION=us-west-2
